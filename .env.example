# Haru Studio — 환경변수 설정 템플릿
# 이 파일을 복사하여 .env 로 이름을 변경한 후 실제 값을 입력하세요.
# cp .env.example .env

# ── Anthropic (Claude) ──────────────────────
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# ── Google AI (Gemini + Imagen) ─────────────
GEMINI_API_KEY="your_gemini_api_key_here"

# ── OpenAI ──────────────────────────────────
OPENAI_API_KEY="your_openai_api_key_here"

# ── Naver DataLab API ────────────────────────
NAVER_CLIENT_ID="your_naver_client_id_here"
NAVER_CLIENT_SECRET="your_naver_client_secret_here"

# ── Naver SearchAds API ──────────────────────
NAVER_ADS_API_KEY="your_naver_ads_api_key_here"
NAVER_ADS_SECRET="your_naver_ads_secret_here"
NAVER_ADS_CUSTOMER_ID="your_naver_ads_customer_id_here"
CUSTOMER_ID="your_naver_ads_customer_id_here"

# ── 네이버 DataLab (추가 계정 정보가 필요한 경우) ──
DATALAB_CLIENT_ID="your_datalab_client_id_here"
DATALAB_CLIENT_SECRET="your_datalab_client_secret_here"

# ── 로그인 비밀번호 ──────────────────────────
HARU_PASSWORD="your_login_password_here"
